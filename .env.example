# Use Atlas or a replica set. Standalone MongoDB does not support transactional workflows.
MONGODB_URI=mongodb://127.0.0.1:27017/campuspulse?replicaSet=rs0
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-generated-secret
PORT=3000
APP_ORIGIN=http://localhost:3000
# Enable only behind a trusted proxy that overwrites forwarding headers.
TRUST_PROXY=false

# Development-only alternatives; never accepted by production preflight.
STORAGE_DRIVER=local
PRIVATE_DATA_DIR=.private-data
SCANNER_DRIVER=development
EMAIL_DRIVER=development

# Production S3 or compatible private object store
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional; leave empty for AWS regional S3
S3_ENDPOINT=

# Production malware scanner, on a private network
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Production email driver: resend
RESEND_API_KEY=
EMAIL_FROM=

# Explicitly disposable test replica-set URI; tests refuse other DB names.
TEST_MONGODB_URI=
# Optional production output override; use same value at build and production start.
# Development always uses its separate .next-dev directory.
# NEXT_BUILD_DIR=.next-v2

# Optional browser-visible imagery key. Restrict by your app origin and provider quotas.
# Satellite is unavailable (with Standard fallback) until configured.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional licensed HTTPS XYZ satellite provider instead of MapTiler; both fields required.
# No private credentials here: NEXT_PUBLIC_* values are embedded in the client build.
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
